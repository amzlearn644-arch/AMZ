# Optional, explicitly configured metadata endpoints. Must return JSON metadata (never installer files).
# Expected shape: {"items": [{"id":"stable-id", "name":"Example", "summary":"...", "description":"...", "category":"Tools", "os":"Windows", "version":"1.0", "homepage_url":"https://...", "download_url":"https://..."}]}
# Do not set guessed endpoints; configure only a verified feed you control or are authorized to use.
WINGET_FEED_URL=
OPENUSE_FEED_URL=
AMZ_ENABLE_FDROID=0
FDROID_INDEX_URL=https://f-droid.org/repo/index-v1.json
FDROID_MAX_ITEMS=200
AMZ_SYNC_CHECK_SECONDS=1800
# AMZ_ALLOW_MANUAL_SYNC=1
# AMZ_DB_PATH=data/amz.sqlite3

# Local admin panel (/admin). Leave empty to keep the panel disabled.
# Use a long, unique password; keep this file (or your .env) out of Git.
AMZ_ADMIN_PASSWORD=
# Optional separate signing key for admin sessions. Changing it signs everyone out.
# AMZ_SECRET_KEY=
