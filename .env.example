# Optional: raises GitHub API limits for Winget and Scoop metadata sync\nGITHUB_TOKEN=\n# AMZ public metadata catalogs. All providers store metadata only; downloads stay on publisher/repository hosts.
AMZ_ENABLE_FDROID=1
FDROID_INDEX_URL=https://f-droid.org/repo/index-v1.json
FDROID_MAX_ITEMS=1000000
AMZ_ENABLE_FDROID_ARCHIVE=1
FDROID_ARCHIVE_INDEX_URL=https://f-droid.org/archive/index-v1.json
FDROID_ARCHIVE_MAX_ITEMS=1000000
AMZ_ENABLE_IZZY=1
IZZY_INDEX_URL=https://apt.izzysoft.de/fdroid/repo/index-v1.json
IZZY_MAX_ITEMS=1000000
AMZ_SYNC_CHECK_SECONDS=1800

# Optional additional JSON metadata feeds; never point these at installer binaries.
WINGET_FEED_URL=
OPENUSE_FEED_URL=

# Optional local database path.
# AMZ_DB_PATH=data/amz.sqlite3

# Admin settings: keep secrets out of Git.
AMZ_ADMIN_PASSWORD=
# AMZ_SECRET_KEY=
